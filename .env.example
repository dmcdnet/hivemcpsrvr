# Hive MCP Server configuration.
# Copy to `.env`, fill in real values, and pass with `docker run --env-file .env`.
# Never commit the real `.env` (it is git-ignored).

# --- Device credentials (recommended for headless / Docker) ---
# Obtain these ONCE by logging in interactively (hive_login + hive_sms_2fa)
# then calling the hive_register_device tool. It returns these three values.
# With them set, the server logs in automatically on startup, no SMS 2FA.
HIVE_DEVICE_GROUP_KEY=
HIVE_DEVICE_KEY=
HIVE_DEVICE_PASSWORD=

# --- Server transport (defaults shown) ---
HIVE_TRANSPORT=sse
HIVE_HOST=0.0.0.0
HIVE_PORT=8000

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR)
HIVE_LOG_LEVEL=INFO
